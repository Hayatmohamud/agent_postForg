# Copy this file to .env and fill in real values for local development.
# See src/lib/env.ts for the typed accessor (`env` / `requireEnv`) — every
# variable below is a member of that file's `EnvVarName` union (12 total).
# Keep the two files in sync: adding/removing a var means updating both.

# --- AI (all agents + poster image generation), via OpenRouter --------------
# The single credential for every model call, text and image.
# Legacy alias `OPEN_ROUTER` is also accepted by the accessor.
OPENROUTER_API_KEY=

# Model tiers (OpenRouter model ids). All optional — sensible defaults apply.
# Orchestration / quality agents (e.g. editor, verify).
LLM_MODEL_SMART=openai/gpt-5.5
# Post writing / light agents (cheaper, faster).
LLM_MODEL_CHEAP=google/gemini-2.5-flash-lite
# General fallback text model (defaults to LLM_MODEL_SMART if unset).
LLM_MODEL=
# Poster image generation model, also called via OpenRouter (no separate
# image-provider key needed). Default is "Nano Banana"; swap the value to
# e.g. openai/gpt-image-2 to use GPT Image 2 instead.
IMAGE_MODEL=google/gemini-3.1-flash-image

# --- Web search (fetch_url / search tools, T03) -----------------------------
SERPER_API_KEY=

# --- Persistence -------------------------------------------------------------
# Local dev default: mongodb://127.0.0.1:27017/postforge
MONGODB_URI=mongodb://127.0.0.1:27017/postforge

# --- Inngest (only required for non-local / cloud sync) ---------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Rate-limit / dedupe guard on POST /api/generate (T19) ------------------
# Both optional — sensible defaults apply (see src/lib/env.ts).
# Max posts allowed in a non-terminal status at once before new runs are refused.
MAX_INFLIGHT_RUNS=3
# Lookback window (hours) for blocking a repeat of the same normalized topic.
DEDUPE_WINDOW_HOURS=24
