# Copy this file to .env and fill in real values for local development.
# See src/lib/env.ts for the typed accessor (`env` / `requireEnv`) — every
# variable below is a member of that file's `EnvVarName` union.
# Keep the two files in sync: adding/removing a var means updating both.

# --- AI (text agents), via Gemini --------------------------------------------
# Text generation (research/verify/write/edit) — get one at aistudio.google.com/apikey.
GEMINI_API_KEY=

# Model tiers (Gemini model ids). All optional — sensible defaults apply.
# Orchestration / quality agents (e.g. editor, verify).
LLM_MODEL_SMART=gemini-3.5-flash
# Post writing / light agents (cheaper, faster).
LLM_MODEL_CHEAP=gemini-3.1-flash-lite

# --- Poster image generation, via Replicate ----------------------------------
# Separate credential from Gemini — get one at replicate.com/account/api-tokens.
# (The Gemini key above has zero free-tier image-generation quota; see CLAUDE.md.)
REPLICATE_API_KEY=
# A Replicate model id ("owner/name"). Default is Flux Schnell (fast, cheap).
IMAGE_MODEL=black-forest-labs/flux-schnell

# --- Web search (fetch_url / search tools, T03) -----------------------------
SERPER_API_KEY=

# --- Persistence -------------------------------------------------------------
# Local dev default: mongodb://127.0.0.1:27017/postforge
MONGODB_URI=mongodb://127.0.0.1:27017/postforge

# --- Inngest (only required for non-local / cloud sync) ---------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Rate-limit / dedupe guard on POST /api/generate (T19) ------------------
# Both optional — sensible defaults apply (see src/lib/env.ts).
# Max posts allowed in a non-terminal status at once before new runs are refused.
MAX_INFLIGHT_RUNS=3
# Lookback window (hours) for blocking a repeat of the same normalized topic.
DEDUPE_WINDOW_HOURS=24

# --- Auth.js (real Google + GitHub OAuth login; JWT sessions, no adapter) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Authorized redirect URI:
# http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# Authorization callback URL:
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Resend (sends the sign-up email-verification OTP) ----------------------
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=
# Sandbox default (no domain verification needed, only delivers to the
# Resend account's own email) — set a verified sender once you add a domain.
RESEND_FROM_EMAIL=onboarding@resend.dev
