# Copy this file to .env and fill in real values for local development.
# See src/lib/env.ts for the typed accessor (`env` / `requireEnv`).

# --- Text generation (all agents, via OpenRouter) ---------------------------
OPENROUTER_API_KEY=
LLM_MODEL=openai/gpt-5.5

# --- Web search (fetch_url / search tools, T03) -----------------------------
SERPER_API_KEY=

# --- Poster / image generation (lib/image.ts provider abstraction) ---------
# Default poster provider: Gemini (gemini-3.1-flash-image).
GEMINI_API_KEY=
# Alternate poster provider: OpenAI (GPT Image). Set IMAGE_PROVIDER=openai to use it.
OPENAI_API_KEY=
# Which poster provider to use: "gemini" (default) or "openai".
IMAGE_PROVIDER=gemini

# --- Persistence -------------------------------------------------------------
# Local dev default: mongodb://127.0.0.1:27017/postforge
MONGODB_URI=mongodb://127.0.0.1:27017/postforge

# --- Inngest (only required for non-local / cloud sync) ---------------------
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
